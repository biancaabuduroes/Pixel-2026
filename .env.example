# Copy to .env.local and fill in the values. Never commit real values.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL (Prisma): pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# "true" enables the demo panel and user switcher. Never enable in production.
DEMO_MODE=

# Long random string; derives and verifies the 6-digit pickup codes. Changing it invalidates existing codes.
PICKUP_CODE_SECRET=

# Optional: LLM insight text (templates are used when unset)
ANTHROPIC_API_KEY=

# Later: secures the scheduled-job endpoint (full MVP)
CRON_SECRET=

# Tests only (not in Vercel): a disposable, migrated local database. Never Supabase.
TEST_DATABASE_URL=
